<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="E-Commerce Test Suite" parallel="true" thread-count="2">

    <listeners>
        <listener class-name="Utility.TestListener"/>
    </listeners>
    <test name="Session Based Tests">
        <parameter name="Browser" value="Chrome"/>
        <groups>
            <run>
                <include name="Session Tests"/>
            </run>
        </groups>
        <classes>
            <class name="Selenium_Framwork.framwork_design.StandAloneTest"/>
        </classes>
    </test> <!-- Test -->

    <test name="Login Validation Tests">
        <parameter name="Browser" value="Chrome"/>
        <groups>
            <run>
                <include name="Login Validation"/>
            </run>
        </groups>
        <classes>
            <class name="Selenium_Framwork.framwork_design.ErrorValidationTest"/>
        </classes>
    </test>

</suite> <!-- Suite -->