pipeline {
    agent any
    stages {

       stage('Checkout Code') {
            steps {
                git branch: 'experiment',
                    url: 'https://github.com/Rahul123456789mondal/Framework_Design.git'
            }
        }

       stage('Run Tests') {
            steps {
                bat 'mvn clean test'
            }
        }

     }
    post {
        always {
            junit 'target/surefire-reports/*.xml'
        }
    }
}